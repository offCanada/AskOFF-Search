# OpenSearch
ASKOFF_OPENSEARCH_HOSTS=localhost:9200
ASKOFF_OPENSEARCH_INDEX=askoff_products
ASKOFF_OPENSEARCH_USE_SSL=false

# Paths
# Canonical local dataset: 124,145 Canada Open Food Facts products with images.
# The pipeline's OFFAdapter auto-detects CSV (read_csv_auto) or Parquet schemas.
ASKOFF_RAW_DATA_PATH=data/raw/off_canada_with_images.parquet
ASKOFF_PROCESSED_DIR=data/processed

# API
ASKOFF_API_HOST=0.0.0.0
ASKOFF_API_PORT=8000

# Pipeline
ASKOFF_PIPELINE_BATCH_SIZE=5000
