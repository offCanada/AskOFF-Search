# Development defaults. Copy to .env and replace only values required by your environment.
ASKOFF_ENVIRONMENT=development
ASKOFF_OPENSEARCH_HOSTS=["opensearch:9200"]
ASKOFF_OPENSEARCH_INDEX=askoff_products
ASKOFF_OPENSEARCH_USE_SSL=false
ASKOFF_OPENSEARCH_VERIFY_CERTS=false
ASKOFF_OPENSEARCH_USERNAME=
ASKOFF_OPENSEARCH_PASSWORD=
ASKOFF_OPENSEARCH_TIMEOUT_SECONDS=5
ASKOFF_OPENSEARCH_MAX_RETRIES=2
ASKOFF_OPENSEARCH_POOL_MAXSIZE=20
ASKOFF_RAW_DATA_PATH=/app/data/raw/off_canada_with_images.parquet
ASKOFF_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
ASKOFF_LOGGING_LEVEL=INFO
ASKOFF_API_DEBUG=false
ASKOFF_REQUEST_MAX_QUERY_LENGTH=500
ASKOFF_REQUEST_MAX_PAGE_SIZE=100
ASKOFF_REQUEST_MAX_OFFSET=10000
ASKOFF_REQUEST_MAX_COMPARE_IDS=50
