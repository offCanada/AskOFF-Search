# Copy to .env.production outside version control and replace every CHANGE_ME value
# through your deployment secret manager. This file is intentionally not runnable.
ASKOFF_ENVIRONMENT=production
ASKOFF_OPENSEARCH_HOSTS=["CHANGE_ME:9200"]
ASKOFF_OPENSEARCH_INDEX=askoff_products
ASKOFF_OPENSEARCH_USE_SSL=true
ASKOFF_OPENSEARCH_VERIFY_CERTS=true
ASKOFF_OPENSEARCH_USERNAME=CHANGE_ME
ASKOFF_OPENSEARCH_PASSWORD=CHANGE_ME
ASKOFF_OPENSEARCH_TIMEOUT_SECONDS=5
ASKOFF_OPENSEARCH_MAX_RETRIES=2
ASKOFF_OPENSEARCH_POOL_MAXSIZE=20
ASKOFF_RAW_DATA_PATH=/app/data/raw/normalized.parquet
ASKOFF_CORS_ORIGINS=["https://CHANGE_ME"]
ASKOFF_API_DEBUG=false
ASKOFF_REQUEST_MAX_QUERY_LENGTH=500
ASKOFF_REQUEST_MAX_PAGE_SIZE=100
ASKOFF_REQUEST_MAX_OFFSET=10000
ASKOFF_REQUEST_MAX_COMPARE_IDS=50
ASKOFF_LOGGING_LEVEL=INFO
